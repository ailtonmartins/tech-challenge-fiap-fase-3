{
  "uid": "visao-servicos-hospital",
  "title": "Hospital - Visão dos Serviços",
  "tags": ["hospital", "spring-boot", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Serviços disponíveis",
      "datasource": "Prometheus",
      "targets": [{ "refId": "A", "expr": "sum(up{job=~\"servico-.*\"})" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 3 }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Disponibilidade por serviço",
      "datasource": "Prometheus",
      "targets": [{ "refId": "A", "expr": "up{job=~\"servico-.*\"}", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Taxa de requisições HTTP",
      "datasource": "Prometheus",
      "targets": [{ "refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"servico-.*\"}[5m]))", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memória heap JVM",
      "datasource": "Prometheus",
      "targets": [{ "refId": "A", "expr": "sum by (job) (jvm_memory_used_bytes{job=~\"servico-.*\",area=\"heap\"})", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs dos serviços",
      "datasource": "Loki",
      "targets": [{ "refId": "A", "expr": "{service_name=~\".*servico-(agendamento|historico|notificacao).*\"}" }],
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": false, "showLabels": false, "sortOrder": "Descending", "wrapLogMessage": true },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 17 }
    }
  ]
}
